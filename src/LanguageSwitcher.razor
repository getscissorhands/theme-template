@inherits LanguageSwitcherBase

@if (Links.Count > 1)
{
    var current = Links.Single(link => link.IsCurrent);
    <li class="language-switcher @Class">
        <details>
            <summary aria-label="@AriaLabel" title="@AriaLabel">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path>
                </svg>
                <span lang="@current.Locale">@current.Label</span>
                <svg class="language-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="m4 6 4 4 4-4"></path>
                </svg>
            </summary>
            <ul>
                @foreach (var link in Links)
                {
                    <li>
                        <a href="@link.Url" lang="@link.Locale" hreflang="@link.Locale"
                           aria-current="@(link.IsCurrent ? "true" : null)">@link.Label</a>
                    </li>
                }
            </ul>
        </details>
    </li>
}
