@using ScissorHands.Core.Urls
@inherits IndexViewBase
@layout MainLayout

<div class="home-layout">
    <section class="home">
        <header class="section-header">
            <h1>Latest posts</h1>
            @if (string.IsNullOrWhiteSpace(Site?.Description) == false)
            {
                <p>@Site.Description</p>
            }
            @if (ThemeSettings!.HeroImages.FirstOrDefault() is { } heroImage)
            {
                <img class="home-hero" src="@ContentUrlHelper.GetImageUrl(heroImage.Source)"
                     alt="@heroImage.Alt" />
            }
        </header>
        @if (Documents?.Any() != true)
        {
            <p class="empty-state">No posts available.</p>
        }
        else
        {
            <div class="post-list">
                @foreach (var post in Documents)
                {
                    <article class="post-card" @attributes="PublicationBadgeBase.GetRegionAttributes(post, PublicationBadgePlacement.Listing)">
                        @if (post.Metadata.Published is { } published)
                        {
                        <time class="post-meta" datetime="@published.ToString("O")">
                            @published.ToString("MMMM dd, yyyy")
                        </time>
                        }
                        <h2 class="post-title">
                        <a href="@GetContentUrl(post.Metadata.Slug)">@post.Metadata.Title</a>
                        </h2>
                        <PublicationBadges Content="@post" Placement="PublicationBadgePlacement.Listing" />
                        @if (string.IsNullOrWhiteSpace(post.Metadata.Description) == false)
                        {
                        <p>@post.Metadata.Description</p>
                        }
                        @if (post.Metadata.Tags.Any())
                        {
                        <ul class="tag-list" aria-label="Post tags">
                            @foreach (var tag in post.Metadata.Tags)
                            {
                                <li><a href="@(LocaleContext?.GetTagUrl(tag) ?? ContentUrlHelper.GetTagUrl(tag))">#@tag</a></li>
                            }
                        </ul>
                        }
                    </article>
                }
            </div>
        }
    </section>
    <aside class="sidebar" aria-label="Site information">
        <h2>About</h2>
        <p>Published by @Site?.Author.</p>
        @if ((LocaleContext is null ? "tags" : LocaleContext.TagIndexUrl) is { } tagIndexUrl)
        {
            <a class="text-link" href="@tagIndexUrl">Browse all tags <span aria-hidden="true">&rarr;</span></a>
        }
    </aside>
</div>
