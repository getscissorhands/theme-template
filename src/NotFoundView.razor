@inherits ScissorHands.Theme.NotFoundViewBase
@layout MainLayout

<section class="content-shell not-found">
    <header class="content-header">
        <p class="error-code">404</p>
        <h1>@(!string.IsNullOrWhiteSpace(Document?.Metadata.Title) ? Document.Metadata.Title : "Page not found")</h1>
    </header>
    <article class="prose">
        @if (string.IsNullOrWhiteSpace(Document?.Html) == true)
        {
            <p>The page you are looking for does not exist.</p>
        }
        else
        {
            @((MarkupString)Document?.Html!)
        }
    </article>
    <a class="text-link" href="."><span aria-hidden="true">&larr;</span> Return home</a>
</section>
