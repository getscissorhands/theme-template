@inherits ScissorHands.Theme.PostViewBase
@layout MainLayout

<section class="content-shell post">
    <header class="content-header">
        <a class="back-link" href="."><span aria-hidden="true">&larr;</span> All posts</a>
        <h1>@Document?.Metadata.Title</h1>
        @if (Document?.Metadata.Published is { } published)
        {
            <time class="post-meta" datetime="@published.ToString("O")">
                @published.ToString("MMMM dd, yyyy")
            </time>
        }
        @if (Document?.Metadata.Tags.Any() == true)
        {
            <ul class="tag-list" aria-label="Post tags">
                @foreach (var tag in Document.Metadata.Tags)
                {
                    <li><a href="@GetTagUrl(tag)">#@tag</a></li>
                }
            </ul>
        }
    </header>
    <article class="prose">
        @((MarkupString)Document?.Html!)
    </article>
</section>
