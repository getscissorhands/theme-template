@using ScissorHands.Core.Models
@inherits MainLayoutBase

<CascadingMainLayoutBase Documents="@Documents"
                         TaggedDocuments="@TaggedDocuments"
                         Tag="@Tag"
                         TaggedPosts="@TaggedPosts"
                         TaggedPages="@TaggedPages"
                         Document="@Document"
                         PageNavigation="@PageNavigation"
                         LocaleContext="@LocaleContext"
                         Plugins="@Plugins"
                         Theme="@Theme"
                         ThemeSettings="@ThemeSettings"
                         Site="@Site">

<!DOCTYPE html>
<html lang="@(string.IsNullOrWhiteSpace(PageLocale) ? null : PageLocale)">
<head>
    <base href="@Site!.BaseUrl" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="@GetThemeUrl("favicon.ico")" />
    <meta name="generator" content="@Site!.Generator" />

    <title>@PageTitle</title>
    <meta name="title" content="@PageTitle" />
    <meta name="description" content="@PageDescription" />
    <LocalizationMetadata />
    <script>
        (() => {
            try {
                const preference = localStorage.getItem("scissorhands-theme-mode");
                if (preference === "light" || preference === "dark") {
                    document.documentElement.dataset.theme = preference;
                }
            } catch (error) {
                if (!(error instanceof DOMException) || error.name !== "SecurityError") throw error;
                console.warn("Colour preference storage is unavailable; using the system preference.", error);
            }
        })();
    </script>
    @if (Theme!.Stylesheets is not null)
    {
        foreach (var css in Theme!.Stylesheets)
        {
            <link rel="stylesheet" href="@GetThemeUrl(css)" />
        }
    }
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <div class="site-shell site-header-inner">
            <a class="site-title" href="@GetHomeUrl()">@Site!.Title</a>
            <nav class="site-navigation" aria-label="Primary navigation">
                <ul class="navigation-list">
                    <li><a href="@GetHomeUrl()">Home</a></li>
                    @RenderNavigation(NavigationTree)
                    @if (GetTagIndexUrl() is { } tagIndexUrl)
                    {
                        <li><a href="@tagIndexUrl">Tags</a></li>
                    }
                    <LanguageSwitcher />
                    <li>
                        <a class="github-link" href="https://github.com/getscissorhands/theme-template"
                           aria-label="View theme template on GitHub" title="GitHub">
                            @* GitHub icon from Simple Icons: https://cdn.simpleicons.org/github *@
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
                            </svg>
                        </a>
                    </li>
                    <li>
                        <button class="theme-toggle" type="button" data-theme-toggle
                                aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
                            <svg class="theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"></path>
                            </svg>
                            <svg class="theme-icon-light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <circle cx="12" cy="12" r="4"></circle>
                                <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
                            </svg>
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    </header>
    <main id="main-content" class="site-shell site-main">
        @Body
    </main>
    <footer class="site-footer">
        <div class="site-shell site-footer-inner">
            <p>&copy; @DateTime.UtcNow.Year @Site.Author</p>
            <p>Powered by <a href="https://getscissorhands.app/">ScissorHands.NET</a></p>
            <p data-current-time-container hidden>
                Your local time: <time data-current-time></time>
            </p>
        </div>
    </footer>
    @if (Theme!.Scripts is not null)
    {
        foreach (var script in Theme!.Scripts)
        {
            <script src="@GetThemeUrl(script)"></script>
        }
    }
</body>
</html>

</CascadingMainLayoutBase>

@code {
    private RenderFragment RenderNavigation(IReadOnlyList<NavigationNode> nodes) => @<text>
        @foreach (var item in nodes)
        {
            var submenuId = $"navigation-submenu-{item.Path}";
            <li class="navigation-item">
                <div class="navigation-link">
                    @if (item.Url is not null)
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                    else
                    {
                        <span class="navigation-label">@item.Title</span>
                    }
                    @if (item.Children.Count > 0)
                    {
                        <button class="navigation-toggle" type="button" aria-expanded="false"
                                aria-controls="@submenuId" aria-label="@($"Toggle {item.Title} pages")" hidden>
                            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                <path d="m4 6 4 4 4-4"></path>
                            </svg>
                        </button>
                    }
                </div>
                @if (item.Children.Count > 0)
                {
                    <ul class="navigation-children" id="@submenuId">
                        @RenderNavigation(item.Children)
                    </ul>
                }
            </li>
        }
    </text>;
}
